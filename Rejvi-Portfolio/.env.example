PORT=3000
APP_ORIGIN=http://localhost:3000
NODE_ENV=development
TRUST_PROXY=0

# FREE persistent production storage (recommended for Render Free)
# Create a free Supabase project, then add these two values in Render > Environment.
# Use the server-side Secret key (sb_secret_...), never a publishable key here.
# SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME

# Optional bucket names. The app creates them automatically on first start.
# SUPABASE_STATE_BUCKET=rejvi-state
# SUPABASE_MEDIA_BUCKET=rejvi-media

# Local fallback only. When Supabase variables are absent, SQLite + local uploads are used.
# DATA_DIR=./data
